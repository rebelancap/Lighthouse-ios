+// LIGHTHOUSE_IOS (overlay 0034): the 2D perf HUD is a UIKit label on the
+// parked window -- invisible on the panel. The shell composes the same text
+// here and the 3D frame draws it into the eye images. Returns -1 when the
+// HUD is off, else the thermal state, which picks the colour.
+extern "C" int SohIos_PerfHud3DText(char* buf, int cap);
+
+// LIGHTHOUSE_IOS (overlay 0034): see Gui.h. DrawGame and
+// CalculateGameViewport are intentionally absent -- the menu composites
+// over the already-rendered eyes rather than hosting the game image.
+void Gui::Soh3DBuildMenuFrame() {
+    HandleMouseCapture();
+    ImGuiWMNewFrame();
+    // The SDL backend just set DisplaySize from the PARKED 480x320 card.
+    // Laying the menu out against that canvas renders it ~8x too large on
+    // the panel. Use a 2D-window-like logical canvas at the eye aspect
+    // instead; the render step's FramebufferScale recompute maps it onto
+    // the eye texture.
+    ImGui::GetIO().DisplaySize = ImVec2(1920.0f, 1080.0f);
+    ImGui::NewFrame();
+    // The main dockspace window normally hosts the game image (DrawGame,
+    // skipped here); left opaque it curtains the rendered eyes. Every
+    // backdrop goes transparent so only menu chrome composites.
+    ImGui::PushStyleColor(ImGuiCol_WindowBg, ImVec4(0, 0, 0, 0));
+    ImGui::PushStyleColor(ImGuiCol_ChildBg, ImVec4(0, 0, 0, 0));
+    ImGui::PushStyleColor(ImGuiCol_DockingEmptyBg, ImVec4(0, 0, 0, 0));
+    DrawMenu();
+    ImGui::PopStyleColor(3);
+    // Notification overlay: Draw() begins its own full-viewport GameOverlay
+    // window, so call it bare. NEVER wrap it in a Begin("Main Game") here --
+    // see the patch header for what that costs.
+    GetGameOverlay()->Draw();
+    // Perf HUD in 3D: same text as the 2D label, top-right, every frame the
+    // HUD CVar is on (independent of menu visibility). The foreground draw
+    // list is part of the draw data, so it reaches both eyes.
+    {
+        char sohHudBuf[64];
+        int sohHudTh = SohIos_PerfHud3DText(sohHudBuf, (int)sizeof(sohHudBuf));
+        if (sohHudTh >= 0 && sohHudBuf[0] != 0) {
+            ImDrawList* sohFg = ImGui::GetForegroundDrawList();
+            ImFont* sohFont = ImGui::GetFont();
+            const float sohHudSize = 30.0f;
+            ImVec2 sohTs = sohFont->CalcTextSizeA(sohHudSize, FLT_MAX, 0.0f, sohHudBuf);
+            ImVec2 sohPos = ImVec2(ImGui::GetIO().DisplaySize.x - sohTs.x - 34.0f, 18.0f);
+            ImU32 sohCol = (sohHudTh >= 2)  ? IM_COL32(255, 102, 77, 242)
+                           : (sohHudTh == 1) ? IM_COL32(255, 204, 102, 230)
+                                             : IM_COL32(255, 255, 255, 217);
+            sohFg->AddText(sohFont, sohHudSize, ImVec2(sohPos.x + 2, sohPos.y + 2),
+                           IM_COL32(0, 0, 0, 200), sohHudBuf);
+            sohFg->AddText(sohFont, sohHudSize, sohPos, sohCol, sohHudBuf);
         }
     }
+    ImGui::Render();
 }
 
+void* Gui::Soh3DGetDrawData() {
+    return (void*)ImGui::GetDrawData();
+}
+
+void Gui::Soh3DFinishMenuFrame() {
+    ImGui::EndFrame();
+    CheckSaveCvars();
+}
