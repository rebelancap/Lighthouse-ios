+// LIGHTHOUSE_IOS (overlay 0059): see LighthouseArchiveVerdict().
+std::string sLhArchiveVerdict = "LH_ARCHIVE check not run";
+
+// The writable copy of `archive` that DetectOTRVersion read, or "" when the
+// located file is not in the app directory (bundle / cwd fallback). Upstream
+// removed the bare name, which on iOS (cwd "/") deleted nothing.
+std::string LhWritableArchivePath(const std::string& archive) {
+    const std::string located = Ship::Context::LocateFileAcrossAppDirs(archive, "bk");
+    const std::string inAppDir = Ship::Context::GetPathRelativeToAppDirectory(archive, "bk");
+    std::error_code ec;
+    if (std::filesystem::exists(inAppDir, ec) && std::filesystem::equivalent(located, inAppDir, ec)) {
+        return inAppDir;
+    }
+    return "";
+}
