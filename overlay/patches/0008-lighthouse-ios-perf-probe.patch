+namespace LighthousePerf {
+// BK ticks at 60/gVIsPerFrame = 30 Hz (D6). Everything sim-rate is against this.
+// BK's NORMAL logic rate. Deliberately not the only value used: the attract
+// demo is a recorded input replay, so upstream renders it uninterpolated at
+// the demo's OWN recorded VI divisor (usually 3 -> 20 Hz, pfsmanager.c ->
+// port_setDemoViCount; "Replay modes never interpolate" in RunCommands).
+// Dividing by a hardcoded 30 there reported entirely correct behaviour as a
+// 33% sim shortfall, and it was escalated as a defect before
+// reading the code. sim_ratio must be measured against the rate the engine is
+// ACTUALLY targeting this tick, or it cries wolf on every non-gameplay screen.
+static constexpr double kLogicHz = 30.0;
+
+static double LhIos_EffectiveLogicHz() {
+    int viPerTick = port_getDemoViCount();
+    if (viPerTick <= 0) {
+        viPerTick = 2 + port_getCutsceneExtraVis(); // gVIsPerFrame = 2
+    }
+    if (viPerTick < 2) {
+        viPerTick = 2;
+    }
+    return 60.0 / (double)viPerTick;
+}
+
+struct Probe {
+    std::vector<double> frameMs, engMs, gpuMs;
+    uint64_t ticks = 0;
+    int lastSub = 0;
+    uint32_t hudFrames = 0;
+    float hudFps = 0.0f;
+    std::chrono::steady_clock::time_point hudWindowStart = std::chrono::steady_clock::now();
+    std::chrono::steady_clock::time_point lastFrame{};
+    std::chrono::steady_clock::time_point lastReport = std::chrono::steady_clock::now();
+
+    void OnFrame(double engineMs, int subframes) {
+        engMs.push_back(engineMs);
+        gpuMs.push_back((double)gSohIosGpuMs);
+        lastSub = subframes;
+        auto now = std::chrono::steady_clock::now();
+        // Count RENDERED frames, not ticks. OnFrame runs once per 30 Hz game
+        // tick and RunCommands renders `subframes` of them inside that call, so
+        // counting calls made the HUD read ~30 on a device genuinely presenting
+        // 120 — it looked like a catastrophic perf problem and cost the user a
+        // bug report. The HUD must show what a player sees.
+        hudFrames += (uint32_t)(subframes > 0 ? subframes : 1);
+        const double hudEl = std::chrono::duration<double>(now - hudWindowStart).count();
+        if (hudEl >= 1.0) {
+            hudFps = (float)(hudFrames / hudEl);
+            hudFrames = 0;
+            hudWindowStart = now;
+        }
+        if (lastFrame.time_since_epoch().count() != 0) {
+            frameMs.push_back(std::chrono::duration<double, std::milli>(now - lastFrame).count());
+        }
+        lastFrame = now;
+    }
 
+    void OnTick() {
+        ticks++;
+        auto now = std::chrono::steady_clock::now();
+        const double el = std::chrono::duration<double>(now - lastReport).count();
+        if (el < 10.0 || frameMs.size() < 8 || engMs.size() < 8) {
+            return;
+        }
+        std::sort(frameMs.begin(), frameMs.end());
+        std::sort(engMs.begin(), engMs.end());
+        std::sort(gpuMs.begin(), gpuMs.end());
+        auto pct = [](std::vector<double>& v, double p) { return v[(size_t)(p * (v.size() - 1))]; };
+        float libMs = 0, psoMs = 0;
+        unsigned int libN = 0, psoN = 0;
+        SohIos_LibWindowStats(&libMs, &libN);
+        SohIos_PsoWindowStats(&psoMs, &psoN);
+        int audMin = -1, audMax = 0;
+        SohIos_AudioStats(&audMin, &audMax);
+        int audFloor = -1;
+        unsigned int audSilent = 0;
+        SohIos_AudioFloor(&audFloor, &audSilent);
+        int s3dInflight = 0;
+        float s3dWaitMs = 0.0f;
+        SohIos_Stereo3DStats(&s3dInflight, &s3dWaitMs);
+        unsigned int hL[4] = { 0, 0, 0, 0 }, hR[4] = { 0, 0, 0, 0 };
+        SohIos_Stereo3DHashes(hL, hR);
+        unsigned int spC = 0, spO = 0, spZ = 0, spA = 0;
+        float spSep = 0.0f, spMix = 0.0f;
+        SohIos_Stereo3DFoldStats(&spC, &spO, &spZ, &spA, &spSep, &spMix);
+        const double simTps = ticks / el;
+        SPDLOG_INFO("LH_PERF wall_ms p50={:.2f} p95={:.2f} p99={:.2f} max={:.2f} "
+                    "eng_ms p50={:.2f} p95={:.2f} max={:.2f} gpu_ms p50={:.2f} p95={:.2f} "
+                    "n={} tick_fps={:.1f} render_fps={:.1f} sim_tps={:.2f} sim_ratio={:.2f} sub={} mode={} thermal={} "
+                    "up_mb={:.1f} up_n={} lib_ms={:.1f} lib_n={} pso_ms={:.1f} pso_n={} aud_min={} aud_max={} aud_floor={} aud_silent={} inflight={} thr_ms={:.1f} hL={:04x},{:04x},{:04x},{:04x} hR={:04x},{:04x},{:04x},{:04x} fold c={} o={} z={} a={} sep={:.2f} mix={:.2f}",
+                    pct(frameMs, 0.5), pct(frameMs, 0.95), pct(frameMs, 0.99), frameMs.back(),
+                    pct(engMs, 0.5), pct(engMs, 0.95), engMs.back(),
+                    pct(gpuMs, 0.5), pct(gpuMs, 0.95),
+                    frameMs.size(), frameMs.size() / el, (frameMs.size() / el) * (double)(lastSub > 0 ? lastSub : 1),
+                    simTps, simTps / LhIos_EffectiveLogicHz(), lastSub, (int)getGameMode(),
+                    SohIos_ThermalState(), gSohIosUpWinBytes / 1048576.0, gSohIosUpWinCount,
+                    libMs, libN, psoMs, psoN, audMin, audMax, audFloor, audSilent,
+                    s3dInflight, s3dWaitMs, hL[0] & 0xffff, hL[1] & 0xffff,
+                    hL[2] & 0xffff, hL[3] & 0xffff, hR[0] & 0xffff, hR[1] & 0xffff,
+                    hR[2] & 0xffff, hR[3] & 0xffff, spC, spO, spZ, spA, spSep, spMix);
+        gSohIosUpWinBytes = 0;
+        gSohIosUpWinCount = 0;
+        frameMs.clear();
+        engMs.clear();
+        gpuMs.clear();
+        ticks = 0;
+        lastReport = now;
+    }
+};
+static Probe gProbe;
+} // namespace LighthousePerf
