--- a/libultraship/cmake/dependencies/ios.cmake
+++ b/libultraship/cmake/dependencies/ios.cmake
@@ -11,6 +11,25 @@
     )
     FetchContent_MakeAvailable(SDL2)
 endif()
+# LIGHTHOUSE_IOS (overlay 0054): iOS 27 made statusBarOrientation a no-op; SDL's
+# UIKit backend reads the window scene's interfaceOrientation instead. Applied
+# at configure time on top of 0021's PATCH_COMMAND result (a second
+# PATCH_COMMAND would have to edit 0021's own lines). git-patch.cmake without
+# reset = apply, or accept already-applied, else FATAL. iOS only: the
+# visionOS SDL tree stays exactly as 0021 makes it.
+if (NOT LIGHTHOUSE_VISIONOS AND NOT ${SDL2_FOUND})
+    if (NOT sdl2_SOURCE_DIR)
+        message(FATAL_ERROR "overlay 0054: sdl2_SOURCE_DIR unset; cannot apply sdl2-ios27-orientation.patch")
+    endif()
+    execute_process(
+        COMMAND ${CMAKE_COMMAND} -Dpatch_file=${CMAKE_CURRENT_SOURCE_DIR}/cmake/dependencies/patches/sdl2-ios27-orientation.patch -Dwith_reset=FALSE -P ${CMAKE_CURRENT_SOURCE_DIR}/cmake/dependencies/git-patch.cmake
+        WORKING_DIRECTORY ${sdl2_SOURCE_DIR}
+        RESULT_VARIABLE sdl2_ios27_patch_ret
+    )
+    if (NOT sdl2_ios27_patch_ret EQUAL 0)
+        message(FATAL_ERROR "overlay 0054: sdl2-ios27-orientation.patch failed to apply")
+    endif()
+endif()
 
