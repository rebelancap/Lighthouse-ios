Overlay patch 0058 (D34): a saved renderer setting can no longer brick launch.

Found in 2S2H (OTA 1.1.1.1 crashed at launch) and reproduced HERE on the
iPhone Air simulator against the 1.1.0 code (artifacts/perf-2026-10-09/
GL-before-crash.ips): Fast3dWindow's constructor offers FAST3D_SDL_OPENGL
unconditionally, but this iOS/visionOS build does not compile the GL backend
(InitWindowManager's `case FAST3D_SDL_OPENGL` is under ENABLE_OPENGL). So a
config with Window.Backend.Id = 2 passes GetSavedWindowBackend's
IsAvailableWindowBackend check, InitWindowManager falls to `default:` with
both APIs null, and Interpreter::Init dereferences null (SIGSEGV) before any
log line beyond "Could not load the correct rendering backend". The menu's
Renderer API combobox offers "OpenGL" from the same list, so one tap bricks
the app until it is reinstalled.

This patch (LUS Fast3dWindow.cpp only):
1. offers FAST3D_SDL_OPENGL only when ENABLE_OPENGL is compiled in (so the
   saved id 2 is rejected and the combobox no longer lists OpenGL);
2. makes InitWindowManager's `default:` recover on __APPLE__: SPDLOG_ERROR,
   switch to FAST3D_SDL_METAL (SetWindowBackend rewrites the config to
   Metal) and construct the Metal pair instead of leaving nulls;
3. logs one INFO line when a saved backend id is rejected (saved -> chosen).

Generated by scripts/lh_genlib.py against the file's state just before this
patch (no earlier overlay patch touches it).

--- a/libultraship/src/fast/Fast3dWindow.cpp
+++ b/libultraship/src/fast/Fast3dWindow.cpp
@@ -36,7 +36,13 @@
         AddAvailableWindowBackend(WindowBackend::FAST3D_SDL_METAL);
     }
 #endif
+    // LIGHTHOUSE_IOS (overlay 0058, D34): only offer GL where it is compiled.
+    // Offered unconditionally, a saved Window.Backend.Id = 2 (or one tap on
+    // "OpenGL" in the Renderer API menu) passed the availability check and
+    // InitWindowManager left both APIs null -> SIGSEGV in Interpreter::Init.
+#ifdef ENABLE_OPENGL
     AddAvailableWindowBackend(WindowBackend::FAST3D_SDL_OPENGL);
+#endif
 }
 
 Fast3dWindow::Fast3dWindow(std::shared_ptr<Ship::Gui> gui)
@@ -134,7 +140,13 @@
 }
 
 void Fast3dWindow::InitWindowManager() {
+    // LIGHTHOUSE_IOS (overlay 0058): say so when the saved backend is refused.
+    const int32_t lhSavedBackend = Ship::Context::GetRawInstance()->GetConfig()->GetInt("Window.Backend.Id", -1);
     SetWindowBackend(GetSavedWindowBackend());
+    if (lhSavedBackend != -1 && lhSavedBackend != GetWindowBackend()) {
+        SPDLOG_INFO("Saved window backend {} is not available in this build; using {} ({})", lhSavedBackend,
+                    GetWindowBackend(), GetWindowBackendName());
+    }
 
     switch (GetWindowBackend()) {
 #ifdef ENABLE_DX11
@@ -157,6 +169,14 @@
 #endif
         default:
             SPDLOG_ERROR("Could not load the correct rendering backend");
+#ifdef __APPLE__
+            // LIGHTHOUSE_IOS (overlay 0058): never leave the APIs null --
+            // Interpreter::Init would crash. Fall back to Metal and persist it.
+            SPDLOG_ERROR("Falling back to Metal (backend id was {})", GetWindowBackend());
+            SetWindowBackend(WindowBackend::FAST3D_SDL_METAL);
+            mRenderingApi = new GfxRenderingAPIMetal();
+            mWindowManagerApi = new GfxWindowBackendSDL2();
+#endif
             break;
     }
 }
