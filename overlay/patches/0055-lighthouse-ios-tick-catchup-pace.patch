+// LIGHTHOUSE_IOS (overlay 0055, D35): REAL-TIME TICK CATCH-UP + the LH_PACE probe.
+// Port of Shipwright 0065 (D-084) via Starship 0041. See the patch header.
+#ifdef __IOS__
+#include "SohIosPace.h"
+
+#include <algorithm>
+#include <vector>
+#include <libultraship/libultraship.h>
+#include <spdlog/spdlog.h>
+
+namespace SohIosPace {
+Clock::time_point gDrawBegin{}, gDrawEnd{}, gSleepBegin{};
+int gFps = 60;
+
+static bool sHaveDrawEnd = false;
+static std::vector<double> sWait, sBusy, sSleep, sTick;
+static uint32_t sSkipped = 0, sSkipTicks = 0;
+static double sDebtSum = 0.0, sDebtMax = 0.0;
+static Clock::time_point sLastReport = Clock::now();
+
+static double Pct(std::vector<double>& v, double p) {
+    if (v.empty()) {
+        return 0.0;
+    }
+    return v[(size_t)(p * (v.size() - 1))];
+}
+
+static void StressSpin() {
+    // Test instrument (gSohIos.PaceStressMs): a deliberately slow frame, so
+    // the catch-up can be proven on a simulator.
+    int ms = CVarGetInteger("gSohIos.PaceStressMs", 0);
+    if (ms > 0 && ms < 200) {
+        auto until = Clock::now() + std::chrono::milliseconds(ms);
+        while (Clock::now() < until) {
+        }
+    }
+}
+
+static void Report(double tickMs, double tickHz) {
+    sTick.push_back(tickMs);
+    auto now = Clock::now();
+    double el = Ms(sLastReport, now) / 1000.0;
+    if (el < 10.0 || sTick.size() < 8) {
+        return;
+    }
+    for (auto* v : { &sWait, &sBusy, &sSleep, &sTick }) {
+        std::sort(v->begin(), v->end());
+    }
+    size_t n = sTick.size();
+    SPDLOG_INFO("LH_PACE tick_ms p50={:.2f} p95={:.2f} max={:.2f} ticks={} tps={:.2f} tick_hz={:.1f} fps={} frames={} "
+                "wait_ms p50={:.2f} p95={:.2f} max={:.2f} busy_ms p50={:.2f} p95={:.2f} max={:.2f} "
+                "sleep_ms p50={:.2f} p95={:.2f} skipped={} skip_ticks={} debt_avg={:.2f} debt_max={:.2f} "
+                "catchup={} stress={} thermal={} power={}",
+                Pct(sTick, 0.5), Pct(sTick, 0.95), sTick.back(), n, n / el, tickHz, gFps, sBusy.size(),
+                Pct(sWait, 0.5), Pct(sWait, 0.95), sWait.empty() ? 0.0 : sWait.back(), Pct(sBusy, 0.5),
+                Pct(sBusy, 0.95), sBusy.empty() ? 0.0 : sBusy.back(), Pct(sSleep, 0.5), Pct(sSleep, 0.95),
+                sSkipped, sSkipTicks, sDebtSum / n, sDebtMax, CVarGetInteger("gSohIos.TickCatchup", 1),
+                CVarGetInteger("gSohIos.PaceStressMs", 0), SohIos_ThermalState(), SohIos_PowerState());
+    sWait.clear();
+    sBusy.clear();
+    sSleep.clear();
+    sTick.clear();
+    sSkipped = 0;
+    sSkipTicks = 0;
+    sDebtSum = 0.0;
+    sDebtMax = 0.0;
+    sLastReport = now;
+}
+} // namespace SohIosPace
+
+using namespace SohIosPace;
+
+extern "C" void SohIos_PaceDrawableBegin(void) {
+    gDrawBegin = Clock::now();
+}
+
+extern "C" void SohIos_PaceDrawableEnd(void) {
+    gDrawEnd = Clock::now();
+    sHaveDrawEnd = true;
+    sWait.push_back(Ms(gDrawBegin, gDrawEnd));
+}
+
+extern "C" void SohIos_PaceSleepBegin(void) {
+    StressSpin();
+    gSleepBegin = Clock::now();
+    if (sHaveDrawEnd) {
+        sBusy.push_back(Ms(gDrawEnd, gSleepBegin));
+        sHaveDrawEnd = false;
+    }
+}
+
+extern "C" void SohIos_PaceSleepEnd(void) {
+    sSleep.push_back(Ms(gSleepBegin, Clock::now()));
+}
+
+// Lighthouse: a "tick" here is one RCP task (one display list = one game
+// tick), measured on the render thread; the game logic itself runs on its own
+// thread, paced by the 60 Hz VI ticker (src/port/OS/OS_VI.cpp), and syncs on
+// the SP/DP done events ServiceRcp raises after each pass -- so a slow render
+// pass can still hold the next tick back (LH_PACE tps is the arbiter). Upstream's own sPassBudgetNs guard (RunCommands) drops the
+// LATER frames of a pass that overruns its tick; this drops the EARLIEST
+// frames of the next pass while the wall clock says the game is behind.
+//
+// Keep a debt: real time elapsed minus ticks x tick period, clamped to
+// [0, one tick]; a stall over 250 ms (load, background, menu hitch) resets it
+// so the game never fast-forwards through a pause. While the debt is at least
+// one frame period, drop that many of THIS tick's EARLIEST interpolated
+// frames, never the last one (the tick's real state). Skipping shortens the
+// tick, which pays the debt back on the next measurement.
+extern "C" int SohIos_TickCatchup(int fps, int viPerTick, int frames) {
+    static Clock::time_point sLastTick{};
+    static double sDebtMs = 0.0;
+    if (fps <= 0 || viPerTick <= 0) {
+        return 0;
+    }
+    gFps = fps;
+    auto now = Clock::now();
+    double tickMs = 1000.0 * viPerTick / 60.0; // exact: 7 VIs is 116.7 ms, not 1000 / (60 / 7)
+    double tickHz = 60.0 / viPerTick;
+    double frameMs = 1000.0 / fps;
+    double el = 0.0;
+    if (Set(sLastTick)) {
+        el = Ms(sLastTick, now);
+        if (el > 250.0) {
+            sDebtMs = 0.0; // a stall: never fast-forward through it
+        } else {
+            sDebtMs = std::clamp(sDebtMs + el - tickMs, 0.0, tickMs);
+        }
+    }
+    sLastTick = now;
+    int skip = 0;
+    if (frames > 1 && gSoh3DMode == 0 && CVarGetInteger("gSohIos.TickCatchup", 1) != 0) {
+        skip = std::min((int)(sDebtMs / frameMs), frames - 1);
+        if (skip > 0) {
+            sSkipped += (uint32_t)skip;
+            sSkipTicks++;
+        }
+    }
+    sDebtSum += sDebtMs;
+    sDebtMax = std::max(sDebtMax, sDebtMs);
+    if (el > 0.0) {
+        Report(el, tickHz);
+    }
+    return skip;
+}
+#endif
