+void Interpreter::Soh3DPaceFrame() {
+    // The window manager's swap pair is where the frame-rate limiter
+    // sleeps. In 3D there is nothing to present -- the compositor paces
+    // itself off the drawable -- but the ENGINE still needs its cadence, so
+    // run the pair without mRapi->EndFrame()'s screen work.
+    mWapi->SwapBuffersBegin();
     mWapi->SwapBuffersEnd();
