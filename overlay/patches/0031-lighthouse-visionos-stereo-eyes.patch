 void GfxRenderingAPIMetal::FinishRender() {
+}
+
+// LIGHTHOUSE_IOS (overlay 0031): end-of-eye-pass flush for stereoscopic 3D.
+// The screen framebuffer was never set up this frame (no drawable -- a
+// hidden window's acquire stalls forever), so EndFrame's present path is
+// unusable: commit every drawn framebuffer's command buffer, ride overlay
+// 0019's pending-mip pass on the last one, and replicate EndFrame's
+// per-frame state cleanup.
+extern "C" {
+extern void* volatile gSoh3DEyeTexture[2];
+}
+#include <chrono>
+#include <condition_variable>
+
+// GPU BACK-PRESSURE FOR THE 3D PATH (overlay 0031 rev2).
+// 2D gets this free: acquiring the next drawable blocks once the swapchain
+// is full. The stereo path never acquires a drawable, never waits on
+// completion, and is paced only by a wall-clock limiter -- so CPU run-ahead
+// is unbounded, and every shared, unfenced resource (the vertex pool above
+// all, plus the frame/coord uniform buffers) is recycled under the GPU as
+// soon as the GPU falls behind. Bounding in-flight PAIRS fixes the whole
+// class at once rather than deepening each buffer separately.
+static constexpr int kSoh3DMaxInFlightPairs = 2;
+static std::atomic<int> sSoh3DInFlight{ 0 };
+static std::mutex sSoh3DThrottleMutex;
+static std::condition_variable sSoh3DThrottleCv;
+static std::atomic<unsigned long long> sSoh3DThrottleWaitNs{ 0 };
+
+// Telemetry for the LH_PERF line (overlay 0008): how deep the queue is and
+// how long the engine actually spent waiting. inflight pinned at the cap
+// with a rising thr_ms means the GPU is the limit, which is the honest
+// reading this path never had.
+extern "C" void SohIos_Stereo3DStats(int* outInflight, float* outWaitMs) {
+    if (outInflight != nullptr) {
+        *outInflight = sSoh3DInFlight.load(std::memory_order_relaxed);
+    }
+    if (outWaitMs != nullptr) {
+        *outWaitMs = (float)(sSoh3DThrottleWaitNs.exchange(0, std::memory_order_relaxed) / 1.0e6);
+    }
+}
+
+void GfxRenderingAPIMetal::Soh3DThrottle() {
+    const auto sohT0 = std::chrono::steady_clock::now();
+    {
+        std::unique_lock<std::mutex> sohLk(sSoh3DThrottleMutex);
+        // Timeout, never an unbounded wait: if the GPU wedges, this must
+        // degrade to a slideshow rather than deadlock the game thread.
+        sSoh3DThrottleCv.wait_for(sohLk, std::chrono::milliseconds(100), [] {
+            return sSoh3DInFlight.load(std::memory_order_acquire) < kSoh3DMaxInFlightPairs;
+        });
+    }
+    sSoh3DThrottleWaitNs.fetch_add(
+        (unsigned long long)std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now() - sohT0)
+            .count(),
+        std::memory_order_relaxed);
+}
+
+static int sSoh3DPublishFb = -1;
+static int sSoh3DPublishEye = -1;
+static std::mutex sSoh3DPublishMutex;
+static void* sSoh3DRetired[16];
+static int sSoh3DRetiredIdx = 0;
+
+void GfxRenderingAPIMetal::Soh3DPublishOnComplete(int fb, int eyeIdx) {
+    sSoh3DPublishFb = fb;
+    sSoh3DPublishEye = eyeIdx;
 }
 
+// EYE-GEOMETRY HASH (overlay 0031 rev4) -- the falsifiable instrument this
+// bug has lacked through four failed fixes. The flicker was reported to be
+// visible with ONE EYE CLOSED, so a single view's CONTENT alternates; and
+// "objects at two locations" is GEOMETRY, which lives in CPU memory here
+// (Fast3D transforms vertices on the CPU into mVertexBufferPool). So hash
+// the bytes actually submitted for each eye pass and keep the last four per
+// eye. Reading them tells the three reported states apart directly:
+//   L[i] != R[i], both varying   -> correct stereo
+//   L[i] == R[i]                 -> both eyes drew the SAME geometry ("2D")
+//   L alternating A,B,A,B        -> one eye alternating between two
+//                                   transforms (the flicker)
+//   L[i] == R[i-1]               -> cross-eye contamination
+// Strided sample, not every byte: this runs per eye pass at up to 120 fps
+// and only has to detect CHANGE, not authenticate content.
+static unsigned int sSoh3DEyeHash[2][4];
+static int sSoh3DEyeHashIdx[2];
+
+extern "C" void SohIos_Stereo3DHashes(unsigned int* outL, unsigned int* outR) {
+    for (int i = 0; i < 4; i++) {
+        if (outL != nullptr) {
+            outL[i] = sSoh3DEyeHash[0][i];
+        }
+        if (outR != nullptr) {
+            outR[i] = sSoh3DEyeHash[1][i];
+        }
+    }
+}
+
+void GfxRenderingAPIMetal::Soh3DEndFrameOffscreen(int eyeIdx) {
+    // Hash BEFORE the pool index advances at the end of this function.
+    if (eyeIdx >= 1 && eyeIdx <= 2) {
+        MTL::Buffer* sohVb = mVertexBufferPool[mCurrentVertexBufferPoolIndex];
+        const unsigned char* sohBytes =
+            (sohVb != nullptr) ? (const unsigned char*)sohVb->contents() : nullptr;
+        unsigned int sohH = 2166136261u; // FNV-1a
+        if (sohBytes != nullptr) {
+            for (size_t sohI = 0; sohI < mCurrentVertexBufferOffset; sohI += 64) {
+                sohH ^= sohBytes[sohI];
+                sohH *= 16777619u;
+            }
+        }
+        // Fold the length in: two passes can sample identically yet submit
+        // different amounts of geometry.
+        sohH ^= (unsigned int)mCurrentVertexBufferOffset;
+        const int sohE = eyeIdx - 1;
+        sSoh3DEyeHash[sohE][sSoh3DEyeHashIdx[sohE] & 3] = sohH;
+        sSoh3DEyeHashIdx[sohE]++;
+    }
+    // The pass's LAST committed command buffer carries the in-flight
+    // release, so find it before committing anything (Metal requires
+    // completion handlers to be attached pre-commit).
+    int sohLastFbId = -1;
+    for (int sohScanId : mDrawnFramebuffers) {
+        if (mFramebuffers[sohScanId].mCommandBuffer != nullptr) {
+            sohLastFbId = sohScanId;
+        }
+    }
+    for (int sohFbId : mDrawnFramebuffers) {
+        auto& sohFb = mFramebuffers[sohFbId];
+        if (sohFb.mCommandBuffer == nullptr) {
+            continue;
+        }
+        if (!sohFb.mHasEndedEncoding && sohFb.mCommandEncoder != nullptr) {
+            sohFb.mCommandEncoder->endEncoding();
+        }
+        if (!sSohIosPendingMips.empty()) {
+            MTL::BlitCommandEncoder* sohBlit = sohFb.mCommandBuffer->blitCommandEncoder();
+            for (MTL::Texture* sohTex : sSohIosPendingMips) {
+                sohBlit->generateMipmaps(sohTex);
+            }
+            sohBlit->endEncoding();
+            for (MTL::Texture* sohTex : sSohIosPendingMips) {
+                sohTex->release();
+            }
+            sSohIosPendingMips.clear();
+        }
+        // Attach the completion-publish for the requested eye fb. The
+        // compositor must never see a texture whose frame is still
+        // mid-GPU: its unfenced cross-queue blit then captures every pass
+        // EXCEPT the final one, which is the one holding the ImGui overlay.
+        // Device-only symptom (the simulator serializes Metal queues), and
+        // it presents as "the game renders but the menu never appears".
+        if (sohFbId == sSoh3DPublishFb) {
+            MTL::Texture* sohPubTex = mTextures[sohFb.mTextureId].texture;
+            int sohPubEye = sSoh3DPublishEye;
+            sSoh3DPublishFb = -1;
+            if (sohPubTex != nullptr && sohPubEye >= 0 && sohPubEye <= 1) {
+                sohPubTex->retain();
+                sohFb.mCommandBuffer->addCompletedHandler(
+                    MTL::HandlerFunction([sohPubTex, sohPubEye](MTL::CommandBuffer* sohCb) {
+                        std::lock_guard<std::mutex> sohLock(sSoh3DPublishMutex);
+                        void* sohOld = (void*)gSoh3DEyeTexture[sohPubEye];
+                        gSoh3DEyeTexture[sohPubEye] = (void*)sohPubTex;
+                        if (sohOld != nullptr) {
+                            void* sohSlot = sSoh3DRetired[sSoh3DRetiredIdx];
+                            if (sohSlot != nullptr) {
+                                ((MTL::Texture*)sohSlot)->release();
+                            }
+                            sSoh3DRetired[sSoh3DRetiredIdx] = sohOld;
+                            sSoh3DRetiredIdx = (sSoh3DRetiredIdx + 1) % 16;
+                        }
+                    }));
+            }
+        }
+        // Count the PAIR as in flight once its final buffer is committed,
+        // and release it when the GPU actually finishes. eyeIdx 2 is the
+        // second eye, i.e. the end of one stereo pair.
+        if (eyeIdx == 2 && sohFbId == sohLastFbId) {
+            sSoh3DInFlight.fetch_add(1, std::memory_order_release);
+            sohFb.mCommandBuffer->addCompletedHandler(
+                MTL::HandlerFunction([](MTL::CommandBuffer* sohCb) {
+                    sSoh3DInFlight.fetch_sub(1, std::memory_order_release);
+                    sSoh3DThrottleCv.notify_all();
+                }));
+        }
+        sohFb.mCommandBuffer->commit();
+    }
+    mDrawnFramebuffers.clear();
+    mCurrentVertexBufferPoolIndex = (mCurrentVertexBufferPoolIndex + 1) % kMaxVertexBufferPoolSize;
+    for (int fb_id = 0; fb_id < (int)mFramebuffers.size(); fb_id++) {
+        FramebufferMetal& fb = mFramebuffers[fb_id];
+        fb.mLastShaderProgram = nullptr;
+        fb.mCommandBuffer = nullptr;
+        fb.mCommandEncoder = nullptr;
+        fb.mHasEndedEncoding = false;
+        fb.mHasBoundVertexShader = false;
+        fb.mHasBoundFragShader = false;
+        for (int i = 0; i < SHADER_MAX_TEXTURES; i++) {
+            fb.mLastBoundTextures[i] = nullptr;
+            fb.mLastBoundSamplers[i] = nullptr;
+        }
+        memset(fb.mViewport, 0, sizeof(MTL::Viewport));
+        memset(fb.mScissorRect, 0, sizeof(MTL::ScissorRect));
+        fb.mLastDepthTest = -1;
+        fb.mLastDepthMask = -1;
+        fb.mLastZmodeDecal = -1;
+    }
+    mFrameAutoreleasePool->release();
+}
