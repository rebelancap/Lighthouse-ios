+
+static void Soh3DStereoP(float out[4][4], const float in[4][4]) {
+    sSoh3DSpCall++;
+    sSoh3DSpLastSep = sSoh3DSep;
+    sSoh3DSpLastMix = sSoh3DPauseMix;
+    memcpy(out, in, sizeof(sSoh3DP));
+    float sohWx = in[0][3], sohWy = in[1][3], sohWz = in[2][3];
+    // PERSPECTIVE DETECT -- threshold is 0.01, NOT the flagship's 0.25.
+    //
+    // guPerspective's last argument scales the whole matrix, and the w-column
+    // scales with it. OoT passes view->scale (1.0), so |w| = 1 and |w|^2 = 1.0,
+    // comfortably clear of 0.25. **Banjo-Kazooie hardcodes 0.5f**
+    // (core1/viewport.c: guPerspective(..., 0.5f)), so |w| = 0.5 and
+    // |w|^2 = 0.25 -- EXACTLY the flagship's threshold. Float noise and the
+    // three rotation MULs that follow push it either side of the line
+    // essentially at random, so the fold applied on some frames and not
+    // others: measured 155160 ortho-rejections out of 164160 calls in
+    // gameplay, with sep and pauseMix both healthy (M-032/M-033).
+    //
+    // On screen that is a stereo-offset frame and a flat frame alternating at
+    // tick rate -- objects snapping between two horizontal positions, visible
+    // with ONE EYE CLOSED, which is what finally identified it.
+    //
+    // A true orthographic matrix has an EXACTLY zero w-column, so the test
+    // only has to separate 0 from 0.5. 0.01 (|w| > 0.1) sits 25x below BK's
+    // value and far above zero, and would still be correct for OoT's 1.0.
+    if (sohWx * sohWx + sohWy * sohWy + sohWz * sohWz < 0.01f) {
+        sSoh3DSpOrtho++;
+        return; // orthographic (HUD/2D): stays on the panel plane
+    }
+    const float e = (sSoh3DEye == 2 ? 1.0f : -1.0f) * 0.5f * sSoh3DSep * sSoh3DPauseMix;
+    if (e == 0.0f) {
