+void Interpreter::Soh3DEndEyePass(int eye) {
+    // Publish ON GPU COMPLETION, never at commit -- the compositor
+    // blit-copies the published texture from its own queue with no
+    // cross-queue fence, and a mid-frame capture contains every pass EXCEPT
+    // the final one (which holds the ImGui overlay): game visible, menu
+    // never. Device-only; the simulator serializes queues and hides it.
+    if (eye >= 1 && eye <= 2 && mSoh3DEyeFb[eye - 1][mSoh3DPing] >= 0) {
+        mRapi->Soh3DPublishOnComplete(mSoh3DEyeFb[eye - 1][mSoh3DPing], eye - 1);
+    }
+    mRapi->Soh3DEndFrameOffscreen(eye);
     mRapi->FinishRender();
+    if (eye >= 1 && eye <= 2) {
+        gSoh3DEyeFrames[eye - 1] = gSoh3DEyeFrames[eye - 1] + 1;
+    }
+}
