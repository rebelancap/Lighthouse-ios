+// reached; it must be bailing. These say which branch, in one run.
+static unsigned int sSoh3DSpCall, sSoh3DSpOrtho, sSoh3DSpZero, sSoh3DSpAppl;
+static float sSoh3DSpLastSep, sSoh3DSpLastMix;
