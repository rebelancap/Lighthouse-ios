+extern "C" void SohIos_Stereo3DFoldStats(unsigned int* c, unsigned int* o, unsigned int* z,
+                                          unsigned int* a, float* sep, float* mix) {
+    if (c) { *c = sSoh3DSpCall; }
+    if (o) { *o = sSoh3DSpOrtho; }
+    if (z) { *z = sSoh3DSpZero; }
+    if (a) { *a = sSoh3DSpAppl; }
+    if (sep) { *sep = sSoh3DSpLastSep; }
+    if (mix) { *mix = sSoh3DSpLastMix; }
+    sSoh3DSpCall = sSoh3DSpOrtho = sSoh3DSpZero = sSoh3DSpAppl = 0;
