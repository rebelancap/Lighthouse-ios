+// Stereo-3D menu: prime ImGui_ImplMetal with an EYE framebuffer's pass
+// descriptor, then render the built draw data into each eye's still-open
+// encoder. FramebufferScale is recomputed against the EYE texture because
+// the SDL2 ImGui backend reports POINTS on iOS.
+void GfxRenderingAPIMetal::Soh3DImGuiPrime(int fb) {
+    if (fb < 0 || fb >= (int)mFramebuffers.size()) {
+        return;
+    }
+    MTL::RenderPassDescriptor* sohPass = mFramebuffers[fb].mRenderPassDescriptor;
+    if (sohPass != nullptr) {
+        ImGui_ImplMetal_NewFrame(sohPass);
+    }
+}
+
+extern "C" volatile int gSoh3DDbgMenuDraws;
+
+void GfxRenderingAPIMetal::Soh3DImGuiRender(int fb, void* drawData) {
+    if (fb < 0 || fb >= (int)mFramebuffers.size() || drawData == nullptr) {
+        return;
+    }
+    auto& sohFb = mFramebuffers[fb];
+    if (sohFb.mCommandBuffer == nullptr || sohFb.mCommandEncoder == nullptr || sohFb.mHasEndedEncoding) {
+        return;
+    }
+    ImDrawData* sohData = (ImDrawData*)drawData;
+    MTL::Texture* sohTex = mTextures[sohFb.mTextureId].texture;
+    if (sohTex != nullptr && sohData->DisplaySize.x > 0.0f && sohData->DisplaySize.y > 0.0f) {
+        sohData->FramebufferScale = ImVec2((float)sohTex->width() / sohData->DisplaySize.x,
+                                           (float)sohTex->height() / sohData->DisplaySize.y);
+    }
+    ImGui_ImplMetal_RenderDrawData(sohData, sohFb.mCommandBuffer, sohFb.mCommandEncoder);
+    gSoh3DDbgMenuDraws = gSoh3DDbgMenuDraws + 1; // telemetry: guards passed
+}
